Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: GlobalPath
      Topic:
        Value: /global_path
      Color: 0; 200; 80
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Lookahead
      Topic:
        Value: /lookahead_marker
  Global Options:
    Fixed Frame: odom
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 40
      Focal Point:
        X: 10
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7
      Yaw: 0.8
